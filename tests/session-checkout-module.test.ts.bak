    const finished = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: first.revision,
      commitMessage: 'fix: legacy cleanup residue',
    })
    if (finished.status !== 'finished') throw new Error(`预期 finished，实际为 ${finished.status}`)

    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    const legacy = registry.managedCheckouts[first.checkout.id]
    legacy.phase = 'finalized'
    legacy.journal = null
    legacy.delivery.cleanup = 'blocked'
    legacy.delivery.cleanupMessage = 'Worktree 的 Git 身份或路径已变化，未执行清理。'
    legacy.revision += 1
    registry.revision += 1
    writeFileSync(registryPath, JSON.stringify(registry, null, 2))

