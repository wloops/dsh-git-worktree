  test('Given an unregistered cleanup path is replaced by another Git repository When retry runs Then it fails closed and preserves the replacement', async () => {
    const context = createContext({ removeWorktreeFailures: 1, removeWorktreeFailureLeavesResidue: true })
    const first = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'cleanup before replacement\n')
    const finished = await context.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: first.revision, commitMessage: 'fix: replacement guard',
    })
    if (finished.status !== 'finished') throw new Error(`预期 finished，实际为 ${finished.status}`)

    rmSync(lease.cwd, { recursive: true, force: true })
    git(context.root, 'init', '-b', 'replacement', lease.cwd)
    git(lease.cwd, 'config', 'user.name', 'Replacement Test')
    git(lease.cwd, 'config', 'user.email', 'replacement@example.test')
    writeFileSync(join(lease.cwd, 'replacement.txt'), 'must survive\n')
    git(lease.cwd, 'add', 'replacement.txt')
    git(lease.cwd, 'commit', '-m', 'replacement')

    const blocked = await context.module.operate({
      action: 'retry_cleanup', sessionId: 'session-1', expectedRevision: finished.target.revision,
    })
    expect(blocked.status).toBe('finished')
    if (blocked.status !== 'finished') throw new Error(`预期 finished，实际为 ${blocked.status}`)
    expect(blocked.cleanup).toBe('pending')
    expect(blocked.cleanupReason).toBe('identity_changed')
    expect(blocked.cleanupMessage).toContain('Git 身份或路径已变化')
    expect(readFileSync(join(lease.cwd, 'replacement.txt'), 'utf8')).toBe('must survive\n')
  }, 60_000)

  test('Given a cleanup receipt path is replaced by a plain directory When retry or reconcile runs Then file identity prevents unattended deletion', async () => {
