  test('Given Agent marks a Worktree ready When user previews and withdraws Then Local is restored and the same review can be previewed or finalized again', async () => {
    const context = createContext()
    context.addSession('session-child', 'project-1', '协作只读会话')
    await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.bind('session-child', { kind: 'inherit', parentSessionId: 'session-1' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'preview task\n')
    const ready = await context.module.markReadyForReview('session-1', {
      detailsMarkdown: '## 变更说明\n\n更新预览任务。',
      summary: '更新预览任务',
      validationStatus: 'passed',
      tests: [{ command: 'bun test', status: 'passed' }],
      suggestedCommitMessage: 'fix: preview task',
    })
    expect(ready.delivery).toMatchObject({
      state: 'ready_for_review',
      review: { detailsMarkdown: '## 变更说明\n\n更新预览任务。', changedFiles: ['tracked.txt'] },
    })
    if (ready.delivery?.state !== 'ready_for_review') throw new Error('预期进入 ready_for_review')
    const originalReview = ready.delivery.review

    const preview = await context.module.operate({
      action: 'preview',
      sessionId: 'session-1',
      expectedRevision: ready.revision,
    })
    expect(preview.status).toBe('previewed')
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('preview task\n')
    expect(preview.target.delivery?.state).toBe('preview_active')
    const previewFollowupLease = await context.module.lease('session-1')
    expect(previewFollowupLease.followupOnly).toBe(true)
    expect((previewFollowupLease as { followupReason?: string }).followupReason).toBe('preview_active')
    expect(previewFollowupLease.cwd).toBe(context.projectRoot)
    const collaboratorPreviewLease = await context.module.lease('session-child')
    expect(collaboratorPreviewLease.followupOnly).toBe(true)
    expect(collaboratorPreviewLease.followupReason).toBe('preview_active')
    expect(collaboratorPreviewLease.cwd).toBe(context.projectRoot)

    const rolledBack = await context.module.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: preview.target.revision,
    })
    expect(rolledBack.status).toBe('preview_rolled_back')
    if (rolledBack.status !== 'preview_rolled_back') throw new Error(`预期 preview_rolled_back，实际为 ${rolledBack.status}`)
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('base\n')
    expect(rolledBack.target.delivery).toEqual({
      state: 'ready_for_review',
      review: originalReview,
    })
    expect(rolledBack.target.reviewSlot).toBe('available')
    expect(existsSync(lease.cwd)).toBe(true)

    const previewAgain = await context.module.operate({
      action: 'preview',
      sessionId: 'session-1',
      expectedRevision: rolledBack.target.revision,
    })
    expect(previewAgain.status).toBe('previewed')
    if (previewAgain.status !== 'previewed') throw new Error('预期再次 Preview 成功')
    const resumeRevision = await context.module.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: previewAgain.target.revision,
      resumeRevision: true,
    })
    expect(resumeRevision).toMatchObject({
      status: 'preview_rolled_back',
      target: { delivery: { state: 'working', iteration: originalReview.iteration } },
    })
    if (resumeRevision.status !== 'preview_rolled_back') throw new Error('预期结构化撤回成功')
    expect(resumeRevision.target.reviewSlot).not.toBe('waiting')
    const resumedLease = await context.module.lease('session-1')
    expect(resumedLease.followupOnly).toBeUndefined()
    expect(resumedLease.cwd).toBe(lease.cwd)
  }, 60_000)

  test('Given Local changes after Preview When rollback cannot be lossless Then Domi detaches the old Preview without touching Local and preserves the Worktree until explicit discard', async () => {
    const context = createContext()
    context.addSession('session-2', 'project-1', '等待验收的第二个任务')
    await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.bind('session-2', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'preview becomes stale\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '制造 stale Preview', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: stale preview',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)

    git(context.projectRoot, 'add', 'tracked.txt')
    git(context.projectRoot, 'commit', '-m', 'chore: advance local during preview')
    const localHeadBeforeDetach = git(context.projectRoot, 'rev-parse', 'HEAD')
    const localStatusBeforeDetach = git(context.projectRoot, 'status', '--porcelain=v1', '-uall')
    const localFileBeforeDetach = readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8')

    const detached = await context.module.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: preview.target.revision,
    })

    expect(detached).toMatchObject({
      status: 'preview_detached',
      reason: 'stale_local',
      attemptedAction: 'rollback_preview',
      target: {
        checkout: { phase: 'ready' },
        delivery: { state: 'preview_detached', reason: 'stale_local', attemptedAction: 'rollback_preview' },
      },
    })
    if (detached.status !== 'preview_detached') throw new Error(`预期 preview_detached，实际为 ${detached.status}`)
    expect(git(context.projectRoot, 'rev-parse', 'HEAD')).toBe(localHeadBeforeDetach)
    expect(git(context.projectRoot, 'status', '--porcelain=v1', '-uall')).toBe(localStatusBeforeDetach)
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8')).toBe(localFileBeforeDetach)
    expect(existsSync(lease.cwd)).toBe(true)
    expect((await context.module.lease('session-1')).cwd).toBe(lease.cwd)
    const waitingTask = await context.module.inspect('session-2')
    expect(waitingTask.reviewSlot).not.toBe('waiting')
    expect(waitingTask.reviewSlotOwnerSessionId).toBeUndefined()

    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    expect(typeof registry.managedCheckouts[preview.target.checkout.id].delivery.preview.previewId).toBe('string')
    const restarted = context.restart()
    const restartedTarget = await restarted.inspect('session-1')
    expect(restartedTarget.delivery?.state).toBe('preview_detached')

    const reactivatePersistedPreview = (): number => {
      const currentRegistry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
      const currentRecord = currentRegistry.managedCheckouts[preview.target.checkout.id]
      currentRecord.delivery = {
        state: 'preview_active',
        review: currentRecord.delivery.review,
        preview: currentRecord.delivery.preview,
      }
      currentRecord.phase = 'ready'
      currentRecord.journal = null
      currentRecord.revision += 1
      currentRegistry.revision += 1
      writeFileSync(registryPath, JSON.stringify(currentRegistry, null, 2))
      return currentRecord.revision
    }

    const finalizeRevision = reactivatePersistedPreview()
    const finalizeDetached = await context.restart().operate({
      action: 'finalize_preview',
      sessionId: 'session-1',
      expectedRevision: finalizeRevision,
      commitMessage: 'fix: should detach instead of overwrite Local',
    })
    expect(finalizeDetached).toMatchObject({ status: 'preview_detached', attemptedAction: 'finalize_preview', reason: 'stale_local' })

    const discardRevision = reactivatePersistedPreview()
    const discardDetached = await context.restart().operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: discardRevision,
      confirmDirty: true,
      rollbackPreview: true,
    })
    expect(discardDetached).toMatchObject({ status: 'preview_detached', attemptedAction: 'discard', reason: 'stale_local' })
    if (discardDetached.status !== 'preview_detached') throw new Error(`预期 preview_detached，实际为 ${discardDetached.status}`)

    const discarded = await context.restart().operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: discardDetached.target.revision,
      confirmDirty: true,
    })
    expect(discarded.status).toBe('discarded')
    expect(existsSync(lease.cwd)).toBe(false)
    expect(git(context.projectRoot, 'rev-parse', 'HEAD')).toBe(localHeadBeforeDetach)
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8')).toBe(localFileBeforeDetach)
  }, 60_000)

  test('Given rollback was interrupted and restart marks recovery_required When retried Then receipt recovery completes and preserves resumeRevision intent', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'recoverable rollback\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '验证 rollback 崩溃恢复',
      validationStatus: 'passed',
      tests: [],
      suggestedCommitMessage: 'fix: recover rollback',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)

    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    const record = registry.managedCheckouts[preview.target.checkout.id]
    record.phase = 'recovery_required'
    record.journal = {
      operation: 'rollback_preview',
      operationId: 'interrupted-rollback',
      step: 'planning',
      startedAt: Date.now(),
      previewId: record.delivery.preview.previewId,
      reviewId: record.delivery.review.reviewId,
      resumeRevision: true,
    }
    record.revision += 1
    registry.revision += 1
    writeFileSync(registryPath, JSON.stringify(registry, null, 2))

    const restarted = context.restart()
    const recovery = await restarted.inspect('session-1')
    expect(recovery).toMatchObject({ checkout: { phase: 'recovery_required' }, delivery: { state: 'preview_active' } })
    const rolledBack = await restarted.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: recovery.revision,
    })

    expect(rolledBack).toMatchObject({
      status: 'preview_rolled_back',
      target: { checkout: { phase: 'ready' }, delivery: { state: 'working', iteration: 1 } },
    })
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').trim()).toBe('base')
  }, 45_000)

