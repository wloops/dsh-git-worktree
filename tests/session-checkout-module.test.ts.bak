    expect(secondLease.followupOnly).toBeUndefined()
    expect(secondLease.cwd).not.toBe(context.projectRoot)
    expect(secondLease.cwd).not.toBe(firstLease.cwd)
    expect(basename(secondLease.cwd)).toContain('--i2--')
    expect(existsSync(secondLease.cwd)).toBe(true)
  }, 30_000)

  test('Given Preview is accepted with 24h retention When Finalize runs Then the committed Worktree is frozen and a new iteration uses a different checkout', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const firstLease = await context.module.lease('session-1')
    writeFileSync(join(firstLease.cwd, 'tracked.txt'), 'retained iteration\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '保留运行环境', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'feat: retain environment',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)
    const before = Date.now()
    const retained = await context.module.operate({
      action: 'finalize_preview', sessionId: 'session-1', expectedRevision: preview.target.revision,
      commitMessage: 'feat: retain environment', retention: 'retain_24h',
    })

    expect(retained).toMatchObject({ status: 'finished', cleanup: 'retained' })
    const retainedTarget = await context.module.inspect('session-1')
    expect(retainedTarget.checkout.phase).toBe('retained')
    expect(retainedTarget.delivery).toMatchObject({ state: 'retained', retention: 'retain_24h', cleanup: 'scheduled' })
    if (retainedTarget.delivery?.state !== 'retained') throw new Error('预期 retained delivery')
    expect(retainedTarget.delivery.expiresAt).toBeGreaterThanOrEqual(before + 24 * 60 * 60 * 1000)
    expect(existsSync(firstLease.cwd)).toBe(true)
    const managed = await context.module.listManagedWorktrees({ projectId: 'project-1' })
    expect(managed).toHaveLength(1)
    expect(managed[0]).toMatchObject({
      checkoutId: retainedTarget.checkout.id,
      ownerSessionTitle: '测试思路',
      state: 'retained',
      retention: 'retain_24h',
      approximateBytes: null,
      canCleanup: false,
    })
    expect(context.getMeasureDirectoryCallCount()).toBe(0)
    expect(JSON.stringify(managed[0])).not.toContain(firstLease.cwd)

    const diagnosed = await context.module.listManagedWorktrees({
      checkoutId: retainedTarget.checkout.id,
      includeDiagnostics: true,
    })
    expect(diagnosed).toHaveLength(1)
    expect(diagnosed[0]).toMatchObject({
      checkoutId: retainedTarget.checkout.id,
      state: 'retained',
      canCleanup: true,
    })
    expect(diagnosed[0]?.approximateBytes).toBeGreaterThan(0)
    expect(context.getMeasureDirectoryCallCount()).toBe(1)

    const followupLease = await context.module.lease('session-1')
    expect(followupLease.followupOnly).toBe(true)
    expect(followupLease.cwd).toBe(context.projectRoot)

    const second = await context.module.beginNextIteration('session-1')
    const secondLease = await context.module.lease('session-1')
    expect(second.delivery).toEqual({ state: 'working', iteration: 2 })
    expect(secondLease.cwd).not.toBe(firstLease.cwd)
    expect(existsSync(firstLease.cwd)).toBe(true)
  }, 60_000)

  test('Given retained, working and dirty finalized Worktrees When cleanup inspection runs Then it is read-only and explains every cleanup decision', async () => {
    const context = createContext({ removeWorktreeFailures: 1 })
    context.addSession('session-2', 'project-1', '仍在工作的任务')
    context.addSession('session-3', 'project-1', '提交后又修改的任务')

    const retainedTarget = await context.module.bind('session-1', { kind: 'isolated' })
    const retainedLease = await context.module.lease('session-1')
    writeFileSync(join(retainedLease.cwd, 'retained.txt'), 'retained\n')
    const retained = await context.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: retainedTarget.revision,
      commitMessage: 'test: retained inspection', retention: 'retain_24h',
    })
    if (retained.status !== 'finished') throw new Error('预期 retained finish')

    await context.module.bind('session-2', { kind: 'isolated' })

    const dirtyTarget = await context.module.bind('session-3', { kind: 'isolated' })
    const dirtyLease = await context.module.lease('session-3')
    writeFileSync(join(dirtyLease.cwd, 'dirty.txt'), 'delivered\n')
    const finalized = await context.module.operate({
      action: 'finish', sessionId: 'session-3', expectedRevision: dirtyTarget.revision,
      commitMessage: 'test: dirty finalized inspection',
    })
    if (finalized.status !== 'finished') throw new Error('预期 finalized finish')
    writeFileSync(join(dirtyLease.cwd, 'after-finalize.txt'), 'must survive\n')

    const before = readFileSync(join(context.configDir, 'managed-checkouts.json'), 'utf8')
    const inspected = await context.module.inspectManagedWorktreeCleanup({ projectId: 'project-1' })
    const after = readFileSync(join(context.configDir, 'managed-checkouts.json'), 'utf8')

    expect(after).toBe(before)
    expect(inspected.map((item) => ({ id: item.checkoutId, eligibility: item.cleanup?.eligibility, reason: item.cleanup?.reason }))).toEqual([
      { id: dirtyTarget.checkout.id, eligibility: 'blocked', reason: 'uncommitted_changes' },
      { id: retainedTarget.checkout.id, eligibility: 'retained', reason: 'retention_active' },
      { id: expect.any(String), eligibility: 'blocked', reason: 'working' },
    ])
    expect(JSON.stringify(inspected)).not.toContain(context.projectRoot)
  }, 120_000)

  test('Given safe, retained and working Worktrees When bulk cleanup runs Then it rechecks and cleans only the safe candidate', async () => {
    const context = createContext({ removeWorktreeFailures: 1 })
    context.addSession('session-2', 'project-1', '仍在工作的任务')
    context.addSession('session-3', 'project-1', '到期可清理的任务')

    const retainedTarget = await context.module.bind('session-1', { kind: 'isolated' })
    const retainedLease = await context.module.lease('session-1')
    writeFileSync(join(retainedLease.cwd, 'retained.txt'), 'retained\n')
    const retained = await context.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: retainedTarget.revision,
      commitMessage: 'test: retain bulk', retention: 'retain_manual',
    })
    if (retained.status !== 'finished') throw new Error('预期 retained finish')

    const working = await context.module.bind('session-2', { kind: 'isolated' })

    const safeTarget = await context.module.bind('session-3', { kind: 'isolated' })
    const safeLease = await context.module.lease('session-3')
    writeFileSync(join(safeLease.cwd, 'safe.txt'), 'safe cleanup\n')
    const safe = await context.module.operate({
      action: 'finish', sessionId: 'session-3', expectedRevision: safeTarget.revision,
      commitMessage: 'test: safe bulk cleanup',
    })
    if (safe.status !== 'finished') throw new Error('预期 finalized finish')

    const inspection = await context.module.inspectManagedWorktreeCleanup({ projectId: 'project-1' })
    const result = await context.module.bulkCleanupManagedWorktrees(inspection.map((item) => ({
      checkoutId: item.checkoutId, expectedRevision: item.revision,
    })))

    expect(result.cleaned).toEqual([{ checkoutId: safeTarget.checkout.id, iteration: 1, commitOid: safe.commitOid }])
    expect(result.retained.map((item) => ({ id: item.checkoutId, eligibility: item.cleanup.eligibility, reason: item.cleanup.reason }))).toEqual([
      { id: retainedTarget.checkout.id, eligibility: 'retained' as const, reason: 'retention_active' as const },
      { id: working.checkout.id, eligibility: 'blocked' as const, reason: 'working' as const },
    ].sort((left, right) => left.id.localeCompare(right.id)))
    expect(existsSync(safeLease.cwd)).toBe(false)
    expect(existsSync(retainedLease.cwd)).toBe(true)
  }, 120_000)

