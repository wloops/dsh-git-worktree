    if (retried.status !== 'finished') throw new Error(`预期 finished，实际为 ${retried.status}`)
    expect(retried.cleanup).toBe('discarded')
    expect(retried.target.checkout.phase).toBe('discarded')
    expect(existsSync(lease.cwd)).toBe(false)
  }, 90_000)

  test('Given finalized cleanup is pending When the owner starts a new iteration Then the historical Worktree can still be retried safely from management', async () => {
    const context = createContext({ removeWorktreeFailures: 1 })
    const first = await context.module.bind('session-1', { kind: 'isolated' })
    const firstLease = await context.module.lease('session-1')
    writeFileSync(join(firstLease.cwd, 'tracked.txt'), 'first delivered iteration\n')
    const pending = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: first.revision,
      commitMessage: 'fix: deliver before cleanup retry',
    })
    if (pending.status !== 'finished') throw new Error(`预期 finished，实际为 ${pending.status}`)
    expect(pending.cleanup).toBe('pending')

    const second = await context.module.beginNextIteration('session-1')
    expect(second.delivery).toEqual({ state: 'working', iteration: 2 })
    expect(second.checkout.id).not.toBe(first.checkout.id)
    const secondLease = await context.module.lease('session-1')
    writeFileSync(join(secondLease.cwd, 'second.txt'), 'second iteration preview\n')
    const secondReady = await context.module.markReadyForReview('session-1', {
      summary: '第二轮不应被旧 cleanup 占用验收槽位',
      validationStatus: 'passed',
      tests: [],
      suggestedCommitMessage: 'fix: second iteration preview',
    })
    const secondPreview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: secondReady.revision })
    expect(secondPreview.status).toBe('previewed')
    if (secondPreview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${secondPreview.status}`)
    await context.module.operate({ action: 'rollback_preview', sessionId: 'session-1', expectedRevision: secondPreview.target.revision })

    const cleaned = await context.module.manageManagedWorktree({
      checkoutId: first.checkout.id,
      expectedRevision: pending.target.revision,
      action: 'retry_cleanup',
    })
    expect(cleaned.state).toBe('delivered')
    expect(existsSync(firstLease.cwd)).toBe(false)
    expect((await context.module.inspect('session-1')).checkout.id).toBe(second.checkout.id)
  }, 120_000)

  test('Given Commit succeeds and Git removal leaves only an unregistered directory residue When the session continues Then cleanup damage does not disable the delivered conversation', async () => {
    const context = createContext({ removeWorktreeFailures: 1, removeWorktreeFailureLeavesResidue: true })
    const first = await context.module.bind('session-1', { kind: 'isolated' })
    const worktreeLease = await context.module.lease('session-1')
    writeFileSync(join(worktreeLease.cwd, 'tracked.txt'), 'delivered despite residue\n')

    const finished = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: first.revision,
      commitMessage: 'fix: keep delivered session usable',
    })

    expect(finished.status).toBe('finished')
    if (finished.status !== 'finished') throw new Error(`预期 finished，实际为 ${finished.status}`)
    expect(finished.cleanup).toBe('pending')
    expect(finished.target.checkout.phase).toBe('finalized')
    expect(finished.target.delivery).toMatchObject({ state: 'finalized', commitOid: finished.commitOid })
    expect(existsSync(worktreeLease.cwd)).toBe(true)

    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    expect(registry.managedCheckouts[first.checkout.id].journal).toMatchObject({
      operation: 'cleanup',
      step: 'removing_worktree',
      managedDirectoryIdentity: {
        device: expect.any(String),
        inode: expect.any(String),
        birthtimeNs: expect.any(String),
      },
    })

    const restarted = context.restart()
    const restored = await restarted.inspect('session-1')
    expect(restored.checkout.phase).toBe('finalized')
    expect(restored.delivery).toMatchObject({ state: 'finalized', commitOid: finished.commitOid })

    const diagnosed = await restarted.listManagedWorktrees({ checkoutId: first.checkout.id, includeDiagnostics: true })
    expect(diagnosed).toHaveLength(1)
    expect(diagnosed[0]).toMatchObject({
      checkoutId: first.checkout.id,
      state: 'cleanup_pending',
      dirty: false,
      canCleanup: true,
    })

    const cleaned = await restarted.operate({
      action: 'retry_cleanup',
      sessionId: 'session-1',
      expectedRevision: restored.revision,
    })
    expect(cleaned.status).toBe('finished')
    if (cleaned.status !== 'finished') throw new Error(`预期 finished，实际为 ${cleaned.status}`)
    expect(cleaned.cleanup).toBe('discarded')
    expect(existsSync(worktreeLease.cwd)).toBe(false)

    const followupLease = await restarted.lease('session-1')
    expect(followupLease).toMatchObject({
      cwd: context.projectRoot,
      followupOnly: true,
      followupReason: 'delivered',
      baseOid: finished.commitOid,
    })

    const second = await restarted.beginNextIteration('session-1')
    expect(second.delivery).toEqual({ state: 'working', iteration: 2 })
    expect(second.checkout.id).not.toBe(first.checkout.id)
  }, 60_000)

