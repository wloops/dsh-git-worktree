      canCleanup: true,
      cleanupMessage: 'Git Worktree 已解除注册，仅剩物理目录残余；可重试清理环境。',
    })

    const cleaned = await restarted.manageManagedWorktree({
      checkoutId: first.checkout.id,
      expectedRevision: diagnosed[0]!.revision,
      action: 'retry_cleanup',
    })
    expect(cleaned.state).toBe('delivered')
    expect(existsSync(lease.cwd)).toBe(false)
  }, 60_000)

