    writeFileSync(join(context.projectRoot, 'tracked.txt'), 'new commit\n')
    git(context.projectRoot, 'add', 'tracked.txt')
    git(context.projectRoot, 'commit', '-m', 'advance')

    await expect(context.module.bindVerifiedIsolated('session-1', {
      expectedCurrentOid: oldOid,
      dirtyConfirmed: true,
    })).rejects.toMatchObject({ code: 'stale_target' })
    expect(git(context.repositoryRoot, 'worktree', 'list', '--porcelain').split(/\r?\n/).filter((line) => line.startsWith('worktree '))).toHaveLength(1)
  })

