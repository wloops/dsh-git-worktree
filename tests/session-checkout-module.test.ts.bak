        status: 'ready',
        plan: {
          revision: 'plan-1',
          localFingerprint: 'local-1',
          isolatedFingerprint: 'isolated-1',
          effectiveBaseOid: 'a'.repeat(40),
          baseStrategy: 'recorded_base',
