    const shellMarker = marker.replace(/\\/g, '/').replace(/'/g, "'\\''")
    writeFileSync(hook, `#!/bin/sh\nprintf hook > '${shellMarker}'\n`)
    chmodSync(hook, 0o755)

    await context.module.bind('session-1', { kind: 'isolated' })

    expect(existsSync(marker)).toBeFalse()
  })

