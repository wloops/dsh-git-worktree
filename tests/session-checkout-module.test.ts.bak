  test('Given Worktree diagnostics are scanning a large directory When another managed mutation starts Then the read-only scan does not hold the mutation lock', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'retained for diagnostics\n')
    const target = await context.module.inspect('session-1')
    const retained = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      commitMessage: 'test: retain diagnostics fixture',
      retention: 'retain_manual',
    })
    if (retained.status !== 'finished') throw new Error(`预期 finished，实际为 ${retained.status}`)

    const pause = context.pauseNextDirectoryMeasure()
    const diagnostics = context.module.listManagedWorktrees({
      checkoutId: retained.target.checkout.id,
      includeDiagnostics: true,
    })
    await pause.started

    const mutation = context.module.manageManagedWorktree({
      checkoutId: retained.target.checkout.id,
      expectedRevision: retained.target.revision,
      action: 'set_retention',
      retention: 'retain_24h',
    })
    const winner = await Promise.race([
      mutation.then(() => 'resolved' as const),
      Bun.sleep(2_000).then(() => 'timeout' as const),
    ])
    pause.resume()
    await diagnostics
    await mutation

    expect(winner).toBe('resolved')
  }, 60_000)

  test('Given expired Worktree cleanup is paused When another working session is inspected Then maintenance does not trigger a renderer timeout', async () => {
    const context = createContext()
    context.addSession('session-2', 'project-1', '并发工作会话')
    await context.module.bind('session-2', { kind: 'local' })
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'retained maintenance fixture\n')
    const target = await context.module.inspect('session-1')
    const retained = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      commitMessage: 'test: retain maintenance fixture',
      retention: 'retain_24h',
    })
    if (retained.status !== 'finished' || retained.target.delivery?.state !== 'retained' || !retained.target.delivery.expiresAt) {
      throw new Error('预期产生定时保留的 Worktree')
    }

    const pause = context.pauseNextGitInspect(lease.cwd)
    const maintenance = context.module.cleanupExpiredRetained(retained.target.delivery.expiresAt + 1)
    await pause.started

    const inspection = context.module.inspect('session-2')
    const winner = await Promise.race([
      inspection.then(() => 'resolved' as const),
      Bun.sleep(2_000).then(() => 'timeout' as const),
    ])
    pause.resume()
    await maintenance
    const inspected = await inspection

    expect(winner).toBe('resolved')
    expect(inspected.checkout.kind).toBe('local')
  }, 60_000)

  test('Given maintenance is queued behind an inspect When another session opens Then it waits for maintenance to start and bypasses it', async () => {
    const context = createContext()
    context.addSession('session-2', 'project-1', '前置检查会话')
    context.addSession('session-3', 'project-1', '后到工作会话')
    await context.module.bind('session-2', { kind: 'local' })
    await context.module.bind('session-3', { kind: 'local' })
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'queued maintenance fixture\n')
    const target = await context.module.inspect('session-1')
    const retained = await context.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: target.revision,
      commitMessage: 'test: retain queued maintenance fixture', retention: 'retain_24h',
    })
    if (retained.status !== 'finished' || retained.target.delivery?.state !== 'retained' || !retained.target.delivery.expiresAt) {
      throw new Error('预期产生定时保留的 Worktree')
    }

    const firstPause = context.pauseNextGitInspect()
    const firstInspection = context.module.inspect('session-2')
    await firstPause.started
    const maintenancePause = context.pauseNextGitInspect(lease.cwd)
    const maintenance = context.module.cleanupExpiredRetained(retained.target.delivery.expiresAt + 1)
    const secondInspection = context.module.inspect('session-3')

    firstPause.resume()
    await maintenancePause.started
    const winner = await Promise.race([
      secondInspection.then(() => 'resolved' as const),
      Bun.sleep(2_000).then(() => 'timeout' as const),
    ])
    maintenancePause.resume()
    await Promise.all([firstInspection, secondInspection, maintenance])

    expect(winner).toBe('resolved')
  }, 60_000)

