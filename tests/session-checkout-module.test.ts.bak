      target: { delivery: { state: 'working', iteration: 1 } },
    })
    expect(git(context.projectRoot, 'status', '--porcelain=v1', '-uall')).toBe('')
  }, 30_000)

  test('Given ApplyWorktree projects a task into Local When the user withdraws it Then the entire task layer is restored before further edits', async () => {
    const context = createContext()
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'first applied layer\n')

    const applied = await context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: target.revision,
    })

    expect(applied.status).toBe('previewed')
    if (applied.status !== 'previewed') throw new Error(`预期 Apply 进入可撤回 Preview，实际为 ${applied.status}`)
    expect(applied.target.delivery?.state).toBe('preview_active')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('first applied layer\n')

    const withdrawn = await context.module.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: applied.target.revision,
      resumeRevision: true,
    })

    expect(withdrawn.status).toBe('preview_rolled_back')
    if (withdrawn.status !== 'preview_rolled_back') throw new Error(`预期完整撤回，实际为 ${withdrawn.status}`)
    expect(withdrawn.target.delivery).toEqual({ state: 'working', iteration: 1 })
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('base\n')
    expect((await context.module.lease('session-1')).cwd).toBe(lease.cwd)

    writeFileSync(join(lease.cwd, 'tracked.txt'), 'second final layer\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: 'Apply 撤回后继续完成任务',
      validationStatus: 'passed',
      tests: [],
      suggestedCommitMessage: 'fix: complete after withdrawn apply',
    })
    const preview = await context.module.operate({
      action: 'preview',
      sessionId: 'session-1',
      expectedRevision: ready.revision,
    })
    expect(preview.status).toBe('previewed')
    if (preview.status !== 'previewed') throw new Error(`预期最终 Preview 成功，实际为 ${preview.status}`)
    const finalized = await context.module.operate({
      action: 'finalize_preview',
      sessionId: 'session-1',
      expectedRevision: preview.target.revision,
      commitMessage: 'fix: complete after withdrawn apply',
    })
    expect(finalized.status).toBe('finished')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('second final layer\n')
    expect(git(context.projectRoot, 'show', '--format=', '--name-only', 'HEAD')).toBe('tracked.txt')
  }, 45_000)

  test('Given a ReadyForReview checkout When read-only preflight runs Then it reports real Git facts without changing revision or Local', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'preflight change\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '只读同步预检', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: preflight',
    })
    const localBefore = readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8')

    const preflight = await context.module.preflight!('session-1', ready.revision)
    const inspected = await context.module.inspect('session-1')

    expect(preflight).toMatchObject({
      status: 'ready',
      localModified: false,
      checkoutId: ready.checkout.id,
      reviewId: ready.delivery?.state === 'ready_for_review' ? ready.delivery.review.reviewId : '',
      revision: ready.revision,
      configuredBaseOid: ready.source.oid,
      localHeadOid: ready.source.oid,
      isolatedHeadOid: ready.current.oid,
      changedFiles: ['tracked.txt'],
    })
    expect(inspected.revision).toBe(ready.revision)
    expect(inspected.delivery?.state).toBe('ready_for_review')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8')).toBe(localBefore)
    expect(git(context.projectRoot, 'status', '--porcelain=v1')).toBe('')
  }, 30_000)

