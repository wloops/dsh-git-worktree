      target: { checkout: { phase: 'ready' } },
    })
  })

  test('Given Apply plan selected an effective base When reversible Preview projection is in flight Then journal persists strategy and both reviewed HEADs', async () => {
    let signalApplyStarted!: () => void
    const applyStarted = new Promise<void>((resolve) => { signalApplyStarted = resolve })
    let releaseApply!: () => void
    const applyGate = new Promise<void>((resolve) => { releaseApply = resolve })
    const effectiveBaseOid = 'd'.repeat(40)
    const localHeadOid = 'e'.repeat(40)
    const isolatedHeadOid = 'f'.repeat(40)
    const applyEngine: SessionCheckoutApplyEngine = {
      inspectReview: async () => ({ status: 'error', error: { code: 'stale_local', message: '不会执行' } }),
      preflight: async () => ({ status: 'error', error: { code: 'stale_local', message: '不会执行' } }),
      plan: async () => ({
        status: 'ready',
        plan: {
          revision: 'plan-effective-base',
          localFingerprint: 'local-effective',
          isolatedFingerprint: 'isolated-effective',
          effectiveBaseOid,
          baseStrategy: 'isolated_contains_local_head',
          localHeadOid,
          localHeadRef: 'refs/heads/main',
          isolatedHeadOid,
          changedFiles: ['tracked.txt'],
        },
      }),
      apply: async () => ({ status: 'error', error: { code: 'stale_local', message: '不会执行' } }),
      finish: async () => ({
        status: 'error',
        error: { code: 'stale_local', message: 'stop after journal inspection' },
      }),
      preview: async () => {
        signalApplyStarted()
        await applyGate
        return { status: 'error', error: { code: 'stale_local', message: 'stop after journal inspection' } }
      },
      rollback: async () => ({ status: 'error', error: { code: 'stale_local', message: '不会执行' } }),
      finalize: async () => ({ status: 'error', error: { code: 'stale_local', message: '不会执行' } }),
    }
    const context = createContext({ applyEngine })
    const target = await context.module.bind('session-1', { kind: 'isolated' })

    const operation = context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: target.revision,
    })
    await applyStarted

    const registry = JSON.parse(readFileSync(join(context.configDir, 'managed-checkouts.json'), 'utf8')) as {
      managedCheckouts: Record<string, { journal: Record<string, unknown> | null }>
    }
    const journal = Object.values(registry.managedCheckouts)[0]?.journal
    expect(journal).toMatchObject({
      operation: 'preview',
      step: 'writing_local',
      effectiveBaseOid,
      baseStrategy: 'isolated_contains_local_head',
      localHeadOid,
      isolatedHeadOid,
    })

    releaseApply()
    expect(await operation).toMatchObject({ status: 'error', code: 'stale_local' })
    expect((await context.module.inspect('session-1')).source).toEqual(target.source)
  })

