  test('Given a legacy blocked registry only has an unregistered non-empty residue When management retries cleanup Then it safely deletes the historical environment', async () => {
    const context = createContext({ removeWorktreeFailures: 1, removeWorktreeFailureLeavesResidue: true })
    const first = await context.module.bind('session-1', { kind: 'isolated' })
