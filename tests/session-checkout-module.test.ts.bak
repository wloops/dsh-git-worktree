  test('Given 旧 ready inspect 被可控 deferred 暂停 When owner 并发 Discard Then inspect 与 Discard 串行且 discarded 不会被旧结果覆盖', async () => {
    const context = createContext()
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const pause = context.pauseNextGitInspect()
    const staleInspect = context.module.inspect('session-1')
    await pause.started

    const discard = context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: false,
    })
    await Bun.sleep(100)

    try {
      expect(context.getRemoveWorktreeCallCount()).toBe(0)
    } finally {
      pause.resume()
    }
    const [, discarded] = await Promise.all([staleInspect, discard])
    const final = await context.module.inspect('session-1')

    expect(discarded).toMatchObject({ status: 'discarded' })
    expect(final.checkout.phase).toBe('discarded')
    if (discarded.status !== 'discarded') throw new Error(`预期 discarded，实际为 ${discarded.status}`)
    expect(final.revision).toBe(discarded.target.revision)
  }, 15_000)

  test('Given a valid v1 managed checkout registry When the module restarts Then it migrates to v2 without losing the checkout identity', async () => {
    const context = createContext()
    const original = await context.module.bind('session-1', { kind: 'isolated' })
    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as {
      version: number
      managedCheckouts: Record<string, Record<string, unknown>>
    }
    registry.version = 1
    for (const record of Object.values(registry.managedCheckouts)) delete record.delivery
    writeFileSync(registryPath, JSON.stringify(registry, null, 2))

    const migrated = await context.restart().inspect('session-1')
    const persisted = JSON.parse(readFileSync(registryPath, 'utf8')) as { version: number }

    expect(migrated.checkout.id).toBe(original.checkout.id)
    expect(migrated.checkout.phase).toBe('ready')
    expect(migrated.delivery).toEqual({ state: 'working', iteration: 1 })
    expect(persisted.version).toBe(2)
  })

  test('Given managed checkout 目录丢失 When inspect/lease Then 标记 recovery_required 并 fail closed', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    rmSync(lease.cwd, { recursive: true, force: true })

    const target = await context.module.inspect('session-1')

    expect(target.checkout.phase).toBe('recovery_required')
    expect(context.module.lease('session-1')).rejects.toMatchObject({ code: 'recovery_required' })
  })

  test('Given ready checkout 的 Git inspect 瞬时失败 When 下一次 inspect 重试 Then 不持久污染 recovery 且自动恢复可租用', async () => {
    const context = createContext()
    const ready = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    context.failNextGitInspect(lease.cwd)

    const transient = await context.module.inspect('session-1')
    const persistedAfterFailure = JSON.parse(readFileSync(join(context.configDir, 'managed-checkouts.json'), 'utf8')) as any
    const recovered = await context.module.inspect('session-1')

    expect(transient.checkout.phase).toBe('recovery_required')
    expect(persistedAfterFailure.managedCheckouts[ready.checkout.id].phase).toBe('ready')
    expect(recovered.checkout.phase).toBe('ready')
    expect((await context.module.lease('session-1')).cwd).toBe(lease.cwd)
  })

  test('Given 无 journal 的健康 checkout 已被旧版本标成 recovery_required When inspect Then 自动完整复验并恢复可租用', async () => {
    const context = createContext()
    const ready = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    registry.managedCheckouts[ready.checkout.id].phase = 'recovery_required'
    registry.managedCheckouts[ready.checkout.id].journal = null
    registry.managedCheckouts[ready.checkout.id].revision += 1
    registry.revision += 1
    writeFileSync(registryPath, JSON.stringify(registry, null, 2))

    const restarted = context.restart()
    const recovered = await restarted.inspect('session-1')

    expect(recovered.checkout.phase).toBe('ready')
    expect((await restarted.lease('session-1')).cwd).toBe(lease.cwd)
  })

  test('Given ready checkout 目录临时缺失后原样恢复且无 create journal When owner Recover Then 完整重验后恢复 ready', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    const parkedRoot = `${lease.cwd}-parked`
    renameSync(lease.cwd, parkedRoot)
    const recovery = await context.module.inspect('session-1')
    renameSync(parkedRoot, lease.cwd)

    const result = await context.module.operate({
      action: 'recover',
      sessionId: 'session-1',
      expectedRevision: recovery.revision,
    })

    expect(recovery.checkout.phase).toBe('recovery_required')
    expect(result).toMatchObject({ status: 'recovered', target: { checkout: { phase: 'ready' } } })
    expect((await context.module.lease('session-1')).cwd).toBe(lease.cwd)
  }, 15_000)

  test('Given managed 路径被另一个 Git 仓库替换 When inspect Then common-dir mismatch 进入 recovery', async () => {
    const context = createContext()
