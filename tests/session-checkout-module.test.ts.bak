  test('Given cleanup was pending and the Worktree gains new changes When retry or reconcile runs Then it blocks instead of force deleting user data', async () => {
    const context = createContext({ removeWorktreeFailures: 1 })
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'cleanup guard\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '清理保护', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: cleanup guard',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)
    const pending = await context.module.operate({
      action: 'finalize_preview', sessionId: 'session-1', expectedRevision: preview.target.revision, commitMessage: 'fix: cleanup guard',
    })
    if (pending.status !== 'finished') throw new Error(`预期 finished，实际为 ${pending.status}`)
    expect(pending.cleanup).toBe('pending')

    writeFileSync(join(lease.cwd, 'after-finalize.txt'), 'must survive\n')
    const blocked = await context.module.operate({ action: 'retry_cleanup', sessionId: 'session-1', expectedRevision: pending.target.revision })
    expect(blocked.status).toBe('finished')
    if (blocked.status !== 'finished') throw new Error(`预期 finished，实际为 ${blocked.status}`)
    expect(blocked.cleanup).toBe('pending')
    expect(blocked.cleanupReason).toBe('modified_after_finalize')
    expect(blocked.cleanupMessage).toContain('提交后出现了新修改')
    expect(existsSync(join(lease.cwd, 'after-finalize.txt'))).toBe(true)

    await context.restart().reconcile()
    expect(existsSync(join(lease.cwd, 'after-finalize.txt'))).toBe(true)
    const inspected = await context.module.inspect('session-1')
    expect(inspected.checkout.phase).toBe('finalized')
    expect(inspected.delivery).toMatchObject({ state: 'finalized', cleanup: 'blocked' })
  }, 60_000)

  test('Given an iteration was delivered When a follow-up only reads Then no checkout is created, but confirmed modification starts iteration two lazily', async () => {
    const context = createContext()
    const first = await context.module.bind('session-1', { kind: 'isolated' })
    const firstLease = await context.module.lease('session-1')
    writeFileSync(join(firstLease.cwd, 'tracked.txt'), 'iteration one\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '第一轮', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: iteration one',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)
    const delivered = await context.module.operate({
      action: 'finalize_preview', sessionId: 'session-1', expectedRevision: preview.target.revision, commitMessage: 'fix: iteration one',
    })
    if (delivered.status !== 'finished') throw new Error(`预期 finished，实际为 ${delivered.status}`)

    const followupLease = await context.module.lease('session-1')
    expect(followupLease.followupOnly).toBe(true)
    expect(followupLease.cwd).toBe(context.projectRoot)
