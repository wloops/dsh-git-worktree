  test('Given applying journal 遗留 When 重启 inspect/recover Then 标记 recovery_required 且绝不猜测 Apply 成功', async () => {
    const crashEngine: SessionCheckoutApplyEngine = {
      inspectReview: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      preflight: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      plan: async () => { throw new Error('模拟 Apply planning 进程崩溃') },
      apply: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      finish: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      preview: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      rollback: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      finalize: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
    }
    const context = createContext({ applyEngine: crashEngine })
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'apply crash\n')

    await expect(context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: target.revision,
    })).rejects.toThrow('模拟 Apply planning 进程崩溃')
    const restarted = context.restart()
    const recovery = await restarted.inspect('session-1')
    const result = await restarted.operate({
      action: 'recover',
      sessionId: 'session-1',
      expectedRevision: recovery.revision,
    })
    const unconfirmedDiscard = await restarted.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: recovery.revision,
      confirmDirty: false,
    })
    const discarded = await restarted.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: recovery.revision,
      confirmDirty: true,
    })

    expect(recovery.checkout.phase).toBe('recovery_required')
    expect(recovery.dirty).toBeTrue()
    expect(result).toMatchObject({ status: 'error', code: 'recovery_unsafe' })
    expect(unconfirmedDiscard).toMatchObject({ status: 'error', code: 'dirty_confirmation_required' })
    expect(discarded).toMatchObject({ status: 'discarded', target: { checkout: { phase: 'discarded' } } })
    expect(existsSync(lease.cwd)).toBeFalse()
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').trim()).toBe('base')
  }, 15_000)

  test('Given preparing journal 且 worktree 已完整创建 When 重启后 Recover Then 恢复 ready 而不覆盖文件', async () => {
