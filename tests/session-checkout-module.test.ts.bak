      confirmDirty: true,
    })

    expect(stale).toMatchObject({ status: 'error', code: 'stale_target' })
    expect(existsSync(lease.cwd)).toBe(true)
  }, 15_000)

  test('Given 用户手工 worktree 与 managed checkout 并存 When Discard managed target Then 只删除精确 managed root', async () => {
    const context = createContext()
    const manualRoot = join(context.root, '用户手工 worktree')
    const baseOid = git(context.projectRoot, 'rev-parse', 'HEAD')
    git(context.projectRoot, 'worktree', 'add', '--detach', manualRoot, baseOid)
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')

    const result = await context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: false,
    })

    expect(result.status).toBe('discarded')
    expect(existsSync(lease.cwd)).toBe(false)
    expect(existsSync(join(manualRoot, 'tracked.txt'))).toBe(true)
    expect(git(manualRoot, 'rev-parse', 'HEAD')).toBe(baseOid)
  })

  test('Given dirty Isolated 与 inherited binding When owner Discard Then 先拒绝并列出协作子会话，释放 child 后才允许确认删除', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.bind('child-session', { kind: 'inherit', parentSessionId: 'session-1' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'dirty discard\n')
    const target = await context.module.inspect('session-1')

    const whileChildBound = await context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: true,
    })
    const inherited = await context.module.operate({
      action: 'discard',
      sessionId: 'child-session',
      expectedRevision: target.revision,
      confirmDirty: true,
    })
    await context.module.releaseSession('child-session', 'delete')
    const unconfirmed = await context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: false,
    })
    const discarded = await context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: true,
    })

    expect(whileChildBound).toMatchObject({
      status: 'error',
      code: 'operation_not_allowed',
      message: expect.stringContaining('测试思路 (worktree)'),
    })
    expect(inherited).toMatchObject({ status: 'error', code: 'not_owner' })
    expect(unconfirmed).toMatchObject({ status: 'error', code: 'dirty_confirmation_required' })
    expect(discarded).toMatchObject({ status: 'discarded', target: { checkout: { phase: 'discarded' } } })
    expect(existsSync(lease.cwd)).toBe(false)
    await expect(context.module.inspect('child-session')).rejects.toMatchObject({ code: 'target_unselected' })
  }, 15_000)

  test('Given dirty Isolated owner When session deletion is requested Then lifecycle refuses and preserves binding and checkout', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'dirty owner\n')

    await expect(context.module.releaseSession('session-1', 'delete')).rejects.toMatchObject({
      code: 'operation_not_allowed',
      message: expect.stringContaining('Apply/Discard'),
    })

    expect((await context.module.inspect('session-1')).dirty).toBe(true)
    expect(existsSync(lease.cwd)).toBe(true)
  })

  test('Given Local owner When session deletion is requested Then only its binding is released', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'local' })

    await context.module.releaseSession('session-1', 'delete')

    await expect(context.module.inspect('session-1')).rejects.toMatchObject({ code: 'target_unselected' })
    expect(existsSync(context.projectRoot)).toBe(true)
  })

  test('Given discarded Isolated owner When session deletion is requested Then binding can be released', async () => {
    const context = createContext()
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.operate({
      action: 'discard',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      confirmDirty: false,
    })

    await context.module.releaseSession('session-1', 'delete')

    await expect(context.module.inspect('session-1')).rejects.toMatchObject({ code: 'target_unselected' })
  })

  test('Given inherited child binding When child session is deleted Then owner binding and checkout remain usable', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.bind('child-session', { kind: 'inherit', parentSessionId: 'session-1' })
    const ownerLease = await context.module.lease('session-1')

    await context.module.releaseSession('child-session', 'delete')

    expect((await context.module.lease('session-1')).cwd).toBe(ownerLease.cwd)
    await expect(context.module.inspect('child-session')).rejects.toMatchObject({ code: 'target_unselected' })
  })

  test('Given dirty orphan and Apply Preview crashes during planning When startup reconcile scans registry Then both are retained and pre-write journal safely returns ready', async () => {
    const crashEngine: SessionCheckoutApplyEngine = {
      inspectReview: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      preflight: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      plan: async () => { throw new Error('模拟 applying 崩溃') },
      apply: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      finish: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      preview: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      rollback: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
      finalize: async () => ({ status: 'error', error: { code: 'invalid_plan', message: '不会执行' } }),
    }
    const context = createContext({ applyEngine: crashEngine })
    await context.module.bind('session-1', { kind: 'isolated' })
    const dirtyLease = await context.module.lease('session-1')
    writeFileSync(join(dirtyLease.cwd, 'tracked.txt'), 'dirty orphan\n')
    context.addSession('applying-owner', 'project-1')
    const applying = await context.module.bind('applying-owner', { kind: 'isolated' })
    const applyingLease = await context.module.lease('applying-owner')
    writeFileSync(join(applyingLease.cwd, 'tracked.txt'), 'applying orphan\n')
    await expect(context.module.operate({
      action: 'apply',
      sessionId: 'applying-owner',
      expectedRevision: applying.revision,
    })).rejects.toThrow('模拟 applying 崩溃')
    context.removeSession('session-1')
    context.removeSession('applying-owner')

    const restarted = context.restart()
    const summary = await restarted.reconcile()

    expect(summary.orphanedCheckoutIds).toHaveLength(2)
    expect(summary.dirtyOrphanedCheckoutIds).toHaveLength(2)
    expect(summary.recoveryRequiredCheckoutIds).not.toContain(applying.checkout.id)
    const [applyingSummary] = await restarted.listManagedWorktrees({ checkoutId: applying.checkout.id })
    expect(applyingSummary?.phase).toBe('ready')
    expect(summary.retainedCheckoutCount).toBe(2)
    expect(existsSync(dirtyLease.cwd)).toBe(true)
    expect(existsSync(applyingLease.cwd)).toBe(true)
  })

  test('Given owner 与 inherited 会话共享 Isolated When 文件变脏后 inspect Then 安全视图实时投影 ownership 与 dirty', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    await context.module.bind('child-session', { kind: 'inherit', parentSessionId: 'session-1' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'dirty\n')

    const owner = await context.module.inspect('session-1')
    const inherited = await context.module.inspect('child-session')

    expect({ ownership: owner.ownership, dirty: owner.dirty }).toEqual({ ownership: 'owner', dirty: true })
    expect({ ownership: inherited.ownership, dirty: inherited.dirty }).toEqual({ ownership: 'inherited', dirty: true })
    expect(JSON.stringify(owner).includes(lease.cwd)).toBe(false)
  })
})
