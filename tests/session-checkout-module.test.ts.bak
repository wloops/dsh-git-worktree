  test('Given owner Isolated has task changes and Local has unrelated staged work When Finish runs Then it creates one task commit and automatically discards the Worktree', async () => {
    const context = createContext()
    writeFileSync(join(context.projectRoot, 'local-staged.txt'), 'keep staged\n')
    git(context.projectRoot, 'add', 'local-staged.txt')
    const stagedBefore = git(context.projectRoot, 'show', ':local-staged.txt')
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'finished task\n')

    const result = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      commitMessage: 'fix: finish task',
    })

    expect(result.status).toBe('finished')
    if (result.status !== 'finished') throw new Error(`预期 finished，实际为 ${result.status}`)
    expect(result.cleanup).toBe('discarded')
    expect(result.commitOid).toBe(git(context.projectRoot, 'rev-parse', 'HEAD'))
    expect(git(context.projectRoot, 'show', '-s', '--format=%s', 'HEAD')).toBe('fix: finish task')
    expect(git(context.projectRoot, 'show', '--format=', '--name-only', 'HEAD')).toBe('tracked.txt')
    expect(git(context.projectRoot, 'show', ':local-staged.txt')).toBe(stagedBefore)
    expect(git(context.projectRoot, 'diff', '--cached', '--name-only')).toBe('local-staged.txt')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').trim()).toBe('finished task')
    expect(result.target.checkout.phase).toBe('discarded')
    expect(existsSync(lease.cwd)).toBe(false)
  }, 45_000)

