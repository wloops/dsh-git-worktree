    await context.module.bind('session-1', { kind: 'isolated' })
    const retainedLease = await context.module.lease('session-1')
    writeFileSync(join(retainedLease.cwd, 'tracked.txt'), 'maintenance drain fixture\n')
    const retainedTarget = await context.module.inspect('session-1')
    const retained = await context.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: retainedTarget.revision,
      commitMessage: 'test: retain drain fixture', retention: 'retain_24h',
    })
    if (retained.status !== 'finished' || retained.target.delivery?.state !== 'retained' || !retained.target.delivery.expiresAt) {
      throw new Error('预期产生定时保留的 Worktree')
    }

    const maintenancePause = context.pauseNextGitInspect(retainedLease.cwd)
    const maintenance = context.module.cleanupExpiredRetained(retained.target.delivery.expiresAt + 1)
    await maintenancePause.started
    const bypassPause = context.pauseNextGitInspect(workingLease.cwd)
    const inspection = context.module.inspect('session-2')
    await bypassPause.started
    const discard = context.module.operate({
      action: 'discard',
      sessionId: 'session-2',
      expectedRevision: workingTarget.revision,
      confirmDirty: false,
    })

    maintenancePause.resume()
    const cleanupPersisted = await Promise.race([
      (async () => {
        while (true) {
          const registry = JSON.parse(readFileSync(join(context.configDir, 'managed-checkouts.json'), 'utf8')) as {
            managedCheckouts: Record<string, { phase: string }>
          }
          if (registry.managedCheckouts[retained.target.checkout.id]?.phase === 'discarded') return 'persisted' as const
          await Bun.sleep(25)
        }
      })(),
      Bun.sleep(20_000).then(() => 'timeout' as const),
    ])
    const mutationWinner = await Promise.race([
      discard.then(() => 'resolved' as const),
      Bun.sleep(500).then(() => 'timeout' as const),
    ])

    expect(cleanupPersisted).toBe('persisted')
    expect(mutationWinner).toBe('timeout')

    bypassPause.resume()
    const [, inspected, discarded] = await Promise.all([maintenance, inspection, discard])
    expect(inspected.checkout.phase).toBe('ready')
    expect(discarded.status).toBe('discarded')
  }, 75_000)

  test('Given retained Worktrees expire When maintenance runs Then only unchanged timed retention is cleaned and manual retention remains', async () => {
    const timed = createContext()
    await timed.module.bind('session-1', { kind: 'isolated' })
    const timedLease = await timed.module.lease('session-1')
    writeFileSync(join(timedLease.cwd, 'tracked.txt'), 'timed retention\n')
    const timedTarget = await timed.module.inspect('session-1')
    const timedResult = await timed.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: timedTarget.revision,
      commitMessage: 'feat: timed retention', retention: 'retain_24h',
    })
    if (timedResult.status !== 'finished' || timedResult.target.delivery?.state !== 'retained') throw new Error('预期 timed retained')
    const expiresAt = timedResult.target.delivery.expiresAt
    if (!expiresAt) throw new Error('预期 expiresAt')
    expect(await timed.module.cleanupExpiredRetained(expiresAt + 1)).toEqual([timedResult.target.checkout.id])
    expect(existsSync(timedLease.cwd)).toBe(false)

    const manual = createContext()
    await manual.module.bind('session-1', { kind: 'isolated' })
    const manualLease = await manual.module.lease('session-1')
    writeFileSync(join(manualLease.cwd, 'tracked.txt'), 'manual retention\n')
    const manualTarget = await manual.module.inspect('session-1')
    const manualResult = await manual.module.operate({
      action: 'finish', sessionId: 'session-1', expectedRevision: manualTarget.revision,
      commitMessage: 'feat: manual retention', retention: 'retain_manual',
    })
    expect(manualResult).toMatchObject({ status: 'finished', cleanup: 'retained' })
    if (manualResult.status !== 'finished') throw new Error('预期 manual finished')
    const extended = await manual.module.manageManagedWorktree({
      checkoutId: manualResult.target.checkout.id,
      expectedRevision: manualResult.target.revision,
      action: 'set_retention',
      retention: 'retain_3d',
    })
    expect(extended).toMatchObject({ retention: 'retain_3d', state: 'retained' })
    const indefinite = await manual.module.manageManagedWorktree({
      checkoutId: extended.checkoutId,
      expectedRevision: extended.revision,
      action: 'set_retention',
      retention: 'retain_manual',
    })
    expect(indefinite.expiresAt).toBeNull()
    expect(await manual.module.cleanupExpiredRetained(Date.now() + 365 * 24 * 60 * 60 * 1000)).toEqual([])
    expect(existsSync(manualLease.cwd)).toBe(true)
  }, 60_000)

