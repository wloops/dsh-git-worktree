  test('Given a subdirectory Isolated changed outside the project When Apply runs Then it fails closed without advancing and project-only retry succeeds', async () => {
    const context = createContext({ projectSubdirectory: join('packages', 'app') })
    writeFileSync(join(context.repositoryRoot, 'outside.txt'), 'outside base\n')
    writeFileSync(join(context.projectRoot, 'layered.txt'), 'layered base\n')
    git(context.repositoryRoot, 'add', '.')
    git(context.repositoryRoot, 'commit', '-m', 'subdirectory fixture')
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    const managedRepositoryRoot = git(lease.cwd, 'rev-parse', '--show-toplevel')
    writeFileSync(join(lease.cwd, 'layered.txt'), 'isolated staged\n')
    git(lease.cwd, 'add', 'layered.txt')
    writeFileSync(join(lease.cwd, 'layered.txt'), 'isolated final unstaged\n')
    writeFileSync(join(lease.cwd, 'new.txt'), 'isolated untracked\n')
    writeFileSync(join(managedRepositoryRoot, 'outside.txt'), 'must not escape\n')

    const rejected = await context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: target.revision,
    })

    expect(rejected).toMatchObject({
      status: 'error',
      code: 'invalid_input',
      target: { checkout: { phase: 'ready' } },
    })
    expect(readFileSync(join(context.projectRoot, 'layered.txt'), 'utf8')).toBe('layered base\n')
    expect(readFileSync(join(context.repositoryRoot, 'outside.txt'), 'utf8')).toBe('outside base\n')
    expect(existsSync(join(context.projectRoot, 'new.txt'))).toBeFalse()

    git(managedRepositoryRoot, 'restore', 'outside.txt')
    if (rejected.status !== 'error' || !rejected.target) throw new Error('预期越界 Apply 被拒绝')
    const applied = await context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: rejected.target.revision,
    })

    expect(applied).toMatchObject({
      status: 'previewed',
      changedFiles: ['layered.txt', 'new.txt'],
      target: { delivery: { state: 'preview_active' } },
    })
    expect(readFileSync(join(context.projectRoot, 'layered.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('isolated final unstaged\n')
    expect(readFileSync(join(context.projectRoot, 'new.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('isolated untracked\n')
    expect(readFileSync(join(context.repositoryRoot, 'outside.txt'), 'utf8')).toBe('outside base\n')
    expect(git(lease.cwd, 'diff', '--cached', '--name-only')).toBe('packages/app/layered.txt')
    expect(git(lease.cwd, 'diff', '--name-only')).toBe('packages/app/layered.txt')
    expect(git(lease.cwd, 'ls-files', '--others', '--exclude-standard')).toBe('new.txt')
  }, 30_000)

