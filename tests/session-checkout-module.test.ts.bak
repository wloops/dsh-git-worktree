  test('Given owner 的 Isolated 修改与 Local staged 文件互不相关 When operate Apply Then staged 状态保留且 Apply 成为可撤回 Preview', async () => {
    const context = createContext()
    writeFileSync(join(context.projectRoot, 'local-staged.txt'), 'local staged\n')
    git(context.projectRoot, 'add', 'local-staged.txt')
    const stagedBefore = git(context.projectRoot, 'diff', '--cached', '--binary')
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'isolated applied\n')

    const result = await context.module.operate({
      action: 'apply',
      sessionId: 'session-1',
      expectedRevision: target.revision,
    })

    expect(result.status).toBe('previewed')
    if (result.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${result.status}`)
    expect(result.target).toMatchObject({ checkout: { phase: 'ready' }, delivery: { state: 'preview_active' } })
    expect(result.changedFiles).toEqual(['tracked.txt'])
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').trim()).toBe('isolated applied')
    expect(git(context.projectRoot, 'diff', '--cached', '--binary')).toBe(stagedBefore)

    const restarted = context.restart()
    const withdrawn = await restarted.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: result.target.revision,
      resumeRevision: true,
    })
    expect(withdrawn.status).toBe('preview_rolled_back')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').trim()).toBe('base')
    expect(git(context.projectRoot, 'diff', '--cached', '--binary')).toBe(stagedBefore)
    expect((await restarted.lease('session-1')).cwd).toBe(lease.cwd)
  }, 30_000)

  test('Given ApplyWorktree has no task delta When requested Then it returns a no-op without creating an empty Preview', async () => {
