    writeFileSync(join(context.projectRoot, 'tracked.txt'), 'became dirty\n')

    await expect(context.module.bindVerifiedIsolated('session-1', {
      expectedCurrentOid: expectedOid,
      dirtyConfirmed: false,
    })).rejects.toMatchObject({ code: 'dirty_confirmation_required' })
    await expect(context.module.inspect('session-1')).rejects.toMatchObject({ code: 'target_unselected' })
    expect(git(context.repositoryRoot, 'worktree', 'list', '--porcelain').split(/\r?\n/).filter((line) => line.startsWith('worktree '))).toHaveLength(1)
  })

  test('Given handoff proof 的 HEAD 已过期 When 最终 binding lock 创建 Then stale_target fail closed', async () => {
