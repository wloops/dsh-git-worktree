  test('Given a collaborator inherits the owner Worktree When it finishes and owner releases it Then history is retained and Finish can continue safely', async () => {
    const context = createContext()
    context.setSessionDelegation('child-session', 'running')
    const target = await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    await context.module.bind('child-session', { kind: 'inherit', parentSessionId: 'session-1' })
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'shared finished task\n')
    const localHeadBefore = git(context.projectRoot, 'rev-parse', 'HEAD')

    const inspected = await context.module.inspect('session-1')
    expect(inspected.collaborators).toEqual([{
      sessionId: 'child-session',
      title: '测试思路 (worktree)',
      status: 'running',
      canRelease: false,
    }])
    const runningRelease = await context.module.operate({
      action: 'release_collaborator',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      collaboratorSessionId: 'child-session',
    })
    expect(runningRelease).toMatchObject({ status: 'error', code: 'collaborator_active' })

    context.setSessionDelegation('child-session', 'paused')
    const unknownStatus = await context.module.inspect('session-1')
    expect(unknownStatus.collaborators?.[0]).toMatchObject({ status: 'unknown', canRelease: false })
    const unknownRelease = await context.module.operate({
      action: 'release_collaborator',
      sessionId: 'session-1',
      expectedRevision: unknownStatus.revision,
      collaboratorSessionId: 'child-session',
    })
    expect(unknownRelease).toMatchObject({ status: 'error', code: 'operation_not_allowed' })
    context.setSessionDelegation('child-session', 'running')

    const blocked = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: target.revision,
      commitMessage: 'fix: shared task',
    })

    expect(blocked).toMatchObject({ status: 'error', code: 'collaborator_active' })
    if (blocked.status !== 'error') throw new Error('预期协作占用阻止 Finish')
    expect(blocked.message).toContain('测试思路 (worktree)（运行中）')
    expect(blocked.message).not.toContain('child-session')
    expect(git(context.projectRoot, 'rev-parse', 'HEAD')).toBe(localHeadBefore)

    context.setSessionDelegation('child-session', 'completed')
    const completed = await context.module.inspect('session-1')
    expect(completed.collaborators?.[0]).toMatchObject({ status: 'completed', canRelease: true })
    context.markSessionDelegationCheckoutReleased('child-session')
    await expect(context.module.lease('child-session')).rejects.toMatchObject({ code: 'operation_not_allowed' })
    const released = await context.module.operate({
      action: 'release_collaborator',
      sessionId: 'session-1',
      expectedRevision: completed.revision,
      collaboratorSessionId: 'child-session',
    })
    expect(released).toMatchObject({
      status: 'collaborator_released',
      collaboratorSessionId: 'child-session',
    })
    if (released.status !== 'collaborator_released') throw new Error('预期释放协作占用')
    expect(released.target.collaborators).toBeUndefined()
    await expect(context.module.inspect('child-session')).rejects.toMatchObject({ code: 'target_unselected' })
    await expect(context.module.bind('child-session', { kind: 'isolated' })).rejects.toMatchObject({ code: 'operation_not_allowed' })
    const finished = await context.module.operate({
      action: 'finish',
      sessionId: 'session-1',
      expectedRevision: released.target.revision,
      commitMessage: 'fix: shared task',
    })
    expect(finished).toMatchObject({ status: 'finished', cleanup: 'discarded' })
    expect(git(context.projectRoot, 'log', '-1', '--format=%s')).toBe('fix: shared task')
    expect(existsSync(lease.cwd)).toBe(false)
  }, 35_000)

