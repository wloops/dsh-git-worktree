    if (pending.status !== 'finished') throw new Error(`预期 finished，实际为 ${pending.status}`)
    expect(pending.cleanup).toBe('pending')

    const replacementRoot = join(context.root, 'replacement-local')
    git(context.root, 'init', '-b', 'main', replacementRoot)
    git(replacementRoot, 'config', 'user.name', 'Replacement Test')
    git(replacementRoot, 'config', 'user.email', 'replacement@example.test')
    writeFileSync(join(replacementRoot, 'replacement.txt'), 'replacement\n')
    git(replacementRoot, 'add', 'replacement.txt')
    git(replacementRoot, 'commit', '-m', 'replacement base')

    const registryPath = join(context.configDir, 'managed-checkouts.json')
    const registry = JSON.parse(readFileSync(registryPath, 'utf8')) as any
    registry.managedCheckouts[first.checkout.id].localRoot = replacementRoot
    registry.managedCheckouts[first.checkout.id].revision += 1
    registry.revision += 1
    writeFileSync(registryPath, JSON.stringify(registry, null, 2))
    const restarted = context.restart()

    const inspected = await restarted.inspect('session-1')
    expect(inspected.checkout.phase).toBe('recovery_required')
    await expect(restarted.lease('session-1')).rejects.toMatchObject({ code: 'recovery_required' })
    const next = await restarted.beginNextIteration('session-1')
    expect(next.checkout).toMatchObject({ id: first.checkout.id, phase: 'recovery_required' })
  }, 60_000)

  test('Given a finalized checkout points at a project root that has been replaced When follow-up starts Then Local identity mismatch still fails closed', async () => {
