    const preview1 = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready1.revision })
    expect(preview1.status).toBe('previewed')
    if (preview1.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview1.status}`)
    const previewHead = git(context.projectRoot, 'rev-parse', 'HEAD')
    const previewStatus = git(context.projectRoot, 'status', '--porcelain=v1', '-uall')
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('first preview\n')

    const target2 = await context.module.inspect('session-2')
    const blocked = await context.module.operate({
      action: 'finish',
      sessionId: 'session-2',
      expectedRevision: target2.revision,
      commitMessage: 'fix: second direct finish',
    })

    expect(blocked).toMatchObject({ status: 'error', code: 'project_acceptance_busy' })
    expect(git(context.projectRoot, 'rev-parse', 'HEAD')).toBe(previewHead)
    expect(git(context.projectRoot, 'status', '--porcelain=v1', '-uall')).toBe(previewStatus)
    expect(existsSync(join(context.projectRoot, 'second.txt'))).toBe(false)

    const withdrawn = await context.module.operate({
      action: 'rollback_preview',
      sessionId: 'session-1',
      expectedRevision: preview1.target.revision,
      resumeRevision: true,
    })
    expect(withdrawn).toMatchObject({ status: 'preview_rolled_back', target: { delivery: { state: 'working', iteration: 1 } } })
    expect(readFileSync(join(context.projectRoot, 'tracked.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('base\n')

    const refreshed2 = await context.module.inspect('session-2')
    const finished2 = await context.module.operate({
      action: 'finish',
      sessionId: 'session-2',
      expectedRevision: refreshed2.revision,
      commitMessage: 'fix: second direct finish',
    })
    expect(finished2.status).toBe('finished')
    expect(readFileSync(join(context.projectRoot, 'second.txt'), 'utf8').replace(/\r\n/g, '\n')).toBe('second direct finish\n')
  }, 60_000)

  test('Given a Local Preview is accepted When Finalize runs Then it creates one commit and cleans the Worktree', async () => {
    const context = createContext()
    await context.module.bind('session-1', { kind: 'isolated' })
    const lease = await context.module.lease('session-1')
    writeFileSync(join(lease.cwd, 'tracked.txt'), 'accepted task\n')
    const ready = await context.module.markReadyForReview('session-1', {
      summary: '完成验收任务',
      validationStatus: 'passed',
      tests: [{ command: 'bun test', status: 'passed' }],
      suggestedCommitMessage: 'fix: accepted task',
    })
    const preview = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready.revision })
    expect(preview.status).toBe('previewed')
    if (preview.status !== 'previewed') throw new Error(`预期 previewed，实际为 ${preview.status}`)

    const finished = await context.module.operate({
      action: 'finalize_preview',
      sessionId: 'session-1',
      expectedRevision: preview.target.revision,
      commitMessage: 'fix: accepted task',
    })

    expect(finished.status).toBe('finished')
    if (finished.status !== 'finished') throw new Error(`预期 finished，实际为 ${finished.status}`)
    expect(finished.cleanup).toBe('discarded')
    expect(finished.commitOid).toBe(git(context.projectRoot, 'rev-parse', 'HEAD'))
    expect(git(context.projectRoot, 'show', '-s', '--format=%s', 'HEAD')).toBe('fix: accepted task')
    expect(finished.target.delivery).toMatchObject({
      state: 'delivered',
      commitOid: finished.commitOid,
      proof: {
        localBranch: git(context.projectRoot, 'branch', '--show-current'),
        localHeadBefore: ready.source.oid,
        localHeadAfter: finished.commitOid,
        changedFiles: ['tracked.txt'],
        commitInLocalHistory: true,
      },
    })
    expect(finished.target.current.oid).toBe(finished.commitOid!)
    expect(finished.target.checkout.phase).toBe('discarded')
    expect(existsSync(lease.cwd)).toBe(false)

    writeFileSync(join(context.projectRoot, 'after-delivery.txt'), 'local moves on\n')
    git(context.projectRoot, 'add', 'after-delivery.txt')
    git(context.projectRoot, 'commit', '-m', 'local continues after delivery')
    const advancedLocalHead = git(context.projectRoot, 'rev-parse', 'HEAD')
    const followup = await context.module.inspect('session-1')
    expect(followup.current.oid).toBe(advancedLocalHead)
    expect(followup.delivery).toMatchObject({
      state: 'delivered',
      commitOid: finished.commitOid,
      proof: { localHeadAfter: finished.commitOid, commitInLocalHistory: true },
    })
  }, 30_000)

