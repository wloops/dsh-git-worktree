    git(context.root, 'init', '-b', 'other', lease.cwd)
    git(lease.cwd, 'config', 'user.name', 'Domi Test')
    git(lease.cwd, 'config', 'user.email', 'domi@example.test')
    writeFileSync(join(lease.cwd, 'other.txt'), 'other\n')
    git(lease.cwd, 'add', 'other.txt')
    git(lease.cwd, 'commit', '-m', 'other')

    const target = await context.module.inspect('session-1')

