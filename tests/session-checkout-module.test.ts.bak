    await context.module.bind('session-2', { kind: 'isolated' })
    writeFileSync(join((await context.module.lease('session-1')).cwd, 'tracked.txt'), 'first preview\n')
    writeFileSync(join((await context.module.lease('session-2')).cwd, 'tracked.txt'), 'second preview\n')
    const ready1 = await context.module.markReadyForReview('session-1', {
      summary: '第一个任务', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: first',
    })
    const ready2 = await context.module.markReadyForReview('session-2', {
      summary: '第二个任务', validationStatus: 'passed', tests: [], suggestedCommitMessage: 'fix: second',
    })
    const preview1 = await context.module.operate({ action: 'preview', sessionId: 'session-1', expectedRevision: ready1.revision })
    expect(preview1.status).toBe('previewed')

    const waiting = await context.module.inspect('session-2')
